# ═══════════════════════════════════════════════════════════════
# Jenkins — The Great Architect of the Digital Realm
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# REQUIRED: Discord Bot Token (https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# REQUIRED: DeepSeek API Key (https://platform.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OPTIONAL: ElevenLabs API Key for voice features (https://elevenlabs.io)
# Without this, voice commands (!join, !leave, !say) are disabled
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# OPTIONAL: Discord channel ID where Jenkins posts announcements & preaching
# If not set, Jenkins auto-detects a #jenkins text channel
ANNOUNCEMENT_CHANNEL_ID=your_channel_id_here

# OPTIONAL: VIP User — The Sacred Presence (gets special greetings,
# auto-join voice, warm responses, exempt from sin detection)
VIP_USER_ID=your_vip_user_id_here

# OPTIONAL: Rival User — The Designated Sinner (gets more frequent
# and harsher sin callouts from the Architect)
RIVAL_USER_ID=your_rival_user_id_here
